# Secret key for JWT verification (Change in Production)
SECRET_KEY=your-production-secret-key-change-this-32-bytes

# Database URL (SQLite default for dev, PostgreSQL supported)
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/private_gpt
DATABASE_URL=sqlite+aiosqlite:///./private_gpt.db

# OpenAI API Key (Required for RAG embeddings and LLM answers)
OPENAI_API_KEY=sk-abcdef1234567890abcdef1234567890abcdef12
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1

# Models Configuration
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Maximum File Upload Size in MBcd
MAX_UPLOAD_SIZE_MB=25

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
